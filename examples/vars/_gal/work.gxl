mod envs {
    env default   {
      data_list =  [ "JAVA", "RUST", "PYTHON"] ;
      data_obj =  {
        JAVA : { NAME: "JAVA", SCORE: 80 },
        RUST : { NAME: "RUST", SCORE: 100 },
        PYTHON : { NAME: "PYTHON", SCORE: 200}
        } ;
    }
}
mod main   {
  flow array_do{
    TVAR = "RUST";
    for ${CUR} in ${ENV.DATA_LIST} {

      gx.echo( "CUR:${CUR}" );
      if ${CUR} == ${TVAR} {
        gx.echo ("target : ${CUR}") ;
      }
    }
  }
  flow obj_do{
    for ${CUR} in ${ENV.DATA_OBJ} {
      gx.echo( "CUR:${CUR.NAME} : ${CUR.SCORE}" );
    }
  }

}
