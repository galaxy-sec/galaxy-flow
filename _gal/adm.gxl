extern mod cfm { git = "https://github.com/galaxy-operators/cfm-gxl.git", branch = "${GXL_CHANNEL:develop}" }
mod  envs {
  env default {
     ROOT= "./";
  }
}
mod main   : ver_adm {

#[auto_load(entry)]
  flow _entry : ver.use {
  }

#[auto_load(exit)]
  flow _set_ver {
    gx.patch_file(
      file   : "./Cargo.toml",
      action : "set",
      marker : "version",
      value  : r#""${VERSION}""#
    );
  }


}
